# AWS認証情報
# 推奨: `aws login` コマンドを使用してください
#
# aws login コマンドを実行すると、一時的な認証情報が自動的に管理されます。
# 長期的なアクセスキーを.envファイルに保存する必要はありません。
#
# 従来の方法（非推奨）:
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Bedrock設定（オプション）
# これらはtemplate.yamlでも設定されています
# AWS_REGION_BEDROCK=us-east-1
# BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
